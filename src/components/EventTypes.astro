---
import { venue } from "../data/venue";
---

<section id="events" class="event-types" aria-labelledby="event-types-title">
  <div class="container event-types__inner">
    <div class="event-types__header">
      <p class="event-types__eyebrow">Occasions</p>

      <h2 id="event-types-title" class="event-types__title">
        Celebrations for Every Special Occasion
      </h2>
    </div>

    <ul class="event-types__list">
      {
        venue.eventTypes.map((eventType) => (
          <li class="event-types__item">
            {eventType}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .event-types {
    background: var(--color-ivory);
  }

  .event-types__inner {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-primary);
  }

  .event-types__header {
    max-width: 760px;
  }

  .event-types__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .event-types__title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .event-types__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .event-types__item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .event-types__inner {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .event-types__list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .event-types__title {
      font-size: clamp(2.3rem, 11vw, 3.5rem);
    }

    .event-types__list {
      margin-top: var(--space-7);
    }

    .event-types__item {
      font-size: 0.9rem;
    }
  }
</style>

