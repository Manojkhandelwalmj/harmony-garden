---
import { venue } from "../data/venue";
---

<section
  id="pricing"
  class="pricing"
  aria-labelledby="pricing-title"
>
  <div class="container pricing__inner">
    <div class="pricing__content">
      <div class="pricing__header">
        <p class="pricing__eyebrow">Pricing &amp; Value</p>

        <h2 id="pricing-title" class="pricing__title">
          A Clear Starting Point for Your Celebration
        </h2>

        <p class="pricing__description">
          Harmony Garden offers a spacious setting for weddings, special
          occasions and event gatherings. This indicative figure provides a
          starting point while keeping final pricing open to your event
          details.
        </p>
      </div>

      <div class="pricing__figure" aria-label="Indicative pricing">
        <p class="pricing__label">Indicative pricing range</p>

        <p class="pricing__amount">
          {venue.pricing.value}
          <span class="pricing__unit">/ {venue.pricing.unit}</span>
        </p>

        {
          venue.pricing.isProvisional && (
            <p class="pricing__status">
              Provisional figure — subject to confirmation.
            </p>
          )
        }
      </div>

      <div class="pricing__note">
        <p>
          Final pricing is subject to confirmation and may depend on the
          specific event details, date and guest requirements.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-cream);
  }

  .pricing__inner {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .pricing__content {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: var(--space-8);
    align-items: end;
  }

  .pricing__header {
    max-width: 760px;
  }

  .pricing__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pricing__title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .pricing__description {
    max-width: 680px;
    margin: var(--space-7) 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .pricing__figure {
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .pricing__label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pricing__amount {
    margin: var(--space-4) 0 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1;
  }

  .pricing__unit {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .pricing__status {
    margin: var(--space-5) 0 0;
    color: var(--color-primary-dark);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .pricing__note {
    grid-column: 1 / -1;
    max-width: 760px;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .pricing__note p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  @media (max-width: 800px) {
    .pricing__inner {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .pricing__content {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .pricing__description {
      margin-top: var(--space-6);
    }

    .pricing__note {
      grid-column: auto;
    }
  }

  @media (max-width: 480px) {
    .pricing__title {
      font-size: clamp(2.3rem, 11vw, 3.5rem);
    }

    .pricing__description {
      font-size: 1rem;
    }

    .pricing__figure {
      padding: var(--space-6);
    }

    .pricing__amount {
      font-size: clamp(2.4rem, 12vw, 3.5rem);
    }
  }
</style>
