---
---

<section
  id="lead-form"
  class="lead-form"
  aria-labelledby="lead-form-title"
>
  <div class="container lead-form__inner">
    <div class="lead-form__header">
      <p class="lead-form__eyebrow">Enquire About Your Event</p>

      <h2 id="lead-form-title" class="lead-form__title">
        Check Availability for Your Celebration
      </h2>

      <p class="lead-form__description">
        Share a few details about your event and the Harmony Garden team can
        follow up regarding availability and arrangements.
      </p>
    </div>

    <form class="lead-form__form" action="" method="post">
      <div class="lead-form__fields">
        <div class="lead-form__field">
          <label class="lead-form__label" for="lead-name">Name</label>
          <input
            class="lead-form__input"
            id="lead-name"
            name="name"
            type="text"
            autocomplete="name"
            required
          />
        </div>

        <div class="lead-form__field">
          <label class="lead-form__label" for="lead-phone">
            Phone Number
          </label>
          <input
            class="lead-form__input"
            id="lead-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            required
          />
        </div>

        <div class="lead-form__field">
          <label class="lead-form__label" for="lead-event-type">
            Event Type
          </label>
          <select
            class="lead-form__input lead-form__select"
            id="lead-event-type"
            name="eventType"
            required
          >
            <option value="" selected disabled>Select event type</option>
            <option value="Wedding">Wedding</option>
            <option value="Reception">Reception</option>
            <option value="Engagement">Engagement</option>
            <option value="Sangeet">Sangeet</option>
            <option value="Birthday">Birthday</option>
            <option value="Family Function">Family Function</option>
            <option value="Corporate Event">Corporate Event</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="lead-form__field">
          <label class="lead-form__label" for="lead-date">Event Date</label>
          <input
            class="lead-form__input"
            id="lead-date"
            name="eventDate"
            type="date"
            required
          />
        </div>

        <div class="lead-form__field">
          <label class="lead-form__label" for="lead-guests">
            Expected Guests
          </label>
          <select
            class="lead-form__input lead-form__select"
            id="lead-guests"
            name="expectedGuests"
            required
          >
            <option value="" selected disabled>Select guest range</option>
            <option value="Under 100">Under 100</option>
            <option value="100â€“300">100â€“300</option>
            <option value="300â€“500">300â€“500</option>
            <option value="500â€“1,000">500â€“1,000</option>
            <option value="1,000+">1,000+</option>
          </select>
        </div>

        <div class="lead-form__field lead-form__field--message">
          <label class="lead-form__label" for="lead-message">
            Message <span class="lead-form__optional">(optional)</span>
          </label>
          <textarea
            class="lead-form__input lead-form__textarea"
            id="lead-message"
            name="message"
            rows="5"
          ></textarea>
        </div>
      </div>

      <div class="lead-form__footer">
        <p class="lead-form__note">
          This form is currently a frontend-only enquiry form. Submission
          handling will be connected separately.
        </p>

        <button class="lead-form__button" type="submit">
          Check Availability
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .lead-form {
    background: var(--color-ivory);
  }

  .lead-form__inner {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .lead-form__header {
    max-width: 760px;
  }

  .lead-form__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .lead-form__title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead-form__description {
    max-width: 680px;
    margin: var(--space-7) 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .lead-form__form {
    margin-top: var(--space-10);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .lead-form__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .lead-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .lead-form__field--message {
    grid-column: 1 / -1;
  }

  .lead-form__label {
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .lead-form__optional {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .lead-form__input {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-white);
    color: var(--color-primary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .lead-form__input:hover {
    border-color: var(--color-primary-dark);
  }

  .lead-form__input::placeholder {
    color: var(--color-text-muted);
  }

  .lead-form__select {
    cursor: pointer;
  }

  .lead-form__textarea {
    min-height: 140px;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    resize: vertical;
  }

  .lead-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .lead-form__note {
    max-width: 560px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .lead-form__button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-6);
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 0.85rem;
    font-weight: 500;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .lead-form__button:hover {
    background: transparent;
    color: var(--color-primary);
  }

  @media (max-width: 800px) {
    .lead-form__inner {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .lead-form__form {
      margin-top: var(--space-8);
      padding: var(--space-7);
    }

    .lead-form__fields {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .lead-form__field--message {
      grid-column: auto;
    }

    .lead-form__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .lead-form__button {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .lead-form__title {
      font-size: clamp(2.3rem, 11vw, 3.5rem);
    }

    .lead-form__description {
      font-size: 1rem;
    }

    .lead-form__form {
      padding: var(--space-6);
    }
  }
</style>
