---
import { facilities } from "../data/facilities";
---

<section id="facilities" class="facilities" aria-labelledby="facilities-title">
  <div class="container facilities__inner">
    <div class="facilities__header">
      <p class="facilities__eyebrow">Facilities</p>

      <h2 id="facilities-title" class="facilities__title">
        Everything You Need, Thoughtfully Arranged
      </h2>

      <p class="facilities__description">
        A clear overview of the facilities and arrangements currently
        indicated for the venue. Some details remain subject to owner
        verification.
      </p>
    </div>

    <ul class="facilities__list">
      {
        facilities.map((facility) => (
          <li class="facilities__item">
            <div class="facilities__content">
              <h3 class="facilities__name">{facility.title}</h3>

              <p class="facilities__description">
                {facility.description}
              </p>

              {"value" in facility && facility.value && (
                <p class="facilities__value">{facility.value}</p>
              )}

              {facility.isProvisional && (
                <p class="facilities__status">Details to be confirmed</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .facilities {
    background: var(--color-ivory);
  }

  .facilities__inner {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .facilities__header {
    max-width: 760px;
  }

  .facilities__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .facilities__title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .facilities__header > .facilities__description {
    max-width: 680px;
    margin: var(--space-7) 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .facilities__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .facilities__item {
    margin: 0;
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .facilities__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .facilities__name {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .facilities__item .facilities__description {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .facilities__value {
    margin: var(--space-5) 0 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .facilities__status {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .facilities__inner {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .facilities__list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .facilities__title {
      font-size: clamp(2.3rem, 11vw, 3.5rem);
    }

    .facilities__header > .facilities__description {
      font-size: 1rem;
    }

    .facilities__item {
      padding: var(--space-6);
    }
  }
</style>
