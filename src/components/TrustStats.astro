---
import { venue } from "../data/venue";
---

<section class="trust-stats" aria-labelledby="trust-stats-title">
  <div class="container trust-stats__inner">
    <h2 id="trust-stats-title" class="sr-only">
      Harmony Garden at a glance
    </h2>

    <dl class="trust-stats__list">
      {
        venue.trustStats.map((stat) => (
          <div class="trust-stats__item">
            <dt class="trust-stats__value">{stat.value}</dt>
            <dd class="trust-stats__label">{stat.label}</dd>
          </div>
        ))
      }
    </dl>

    <p class="trust-stats__note">
      * Prototype figures pending owner verification.
    </p>
  </div>
</section>

<style>
  .trust-stats {
    background: var(--color-ivory);
  }

  .trust-stats__inner {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .trust-stats__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
  }

  .trust-stats__item {
    padding-inline: var(--space-6);
    border-left: 1px solid var(--color-border);
  }

  .trust-stats__item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .trust-stats__item:last-child {
    padding-right: 0;
  }

  .trust-stats__value {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .trust-stats__label {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .trust-stats__note {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .trust-stats__inner {
      padding-top: var(--space-7);
      padding-bottom: var(--space-7);
    }

    .trust-stats__list {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-7);
    }

    .trust-stats__item {
      padding-inline: var(--space-5);
    }

    .trust-stats__item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .trust-stats__item:nth-child(4) {
      padding-right: 0;
    }
  }

  @media (max-width: 480px) {
    .trust-stats__inner {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }

    .trust-stats__list {
      row-gap: var(--space-6);
    }

    .trust-stats__item {
      padding-inline: var(--space-4);
    }

    .trust-stats__value {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .trust-stats__label {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
    }

    .trust-stats__note {
      margin-top: var(--space-5);
    }
  }
</style>
