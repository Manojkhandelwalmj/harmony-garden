---
import { venue } from "../data/venue";
---

<section id="venue" class="venue-spaces" aria-labelledby="venue-spaces-title">
  <div class="container venue-spaces__inner">
    <div class="venue-spaces__header">
      <p class="venue-spaces__eyebrow">Venue Spaces</p>

      <h2 id="venue-spaces-title" class="venue-spaces__title">
        Spaces Designed for Celebrations
      </h2>

      <p class="venue-spaces__description">
        Explore the venue setting available for weddings, special occasions and
        event gatherings at Harmony Garden.
      </p>
    </div>

    <ul class="venue-spaces__list">
      {
        venue.venueSpaces.map((space) => (
          <li class="venue-spaces__item">
            <h3 class="venue-spaces__item-title">{space.title}</h3>
            <p class="venue-spaces__item-description">
              {space.description}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="venue-spaces__note">
      Venue-space details are provisional and pending owner verification.
    </p>
  </div>
</section>

<style>
  .venue-spaces {
    background: var(--color-cream);
  }

  .venue-spaces__inner {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-primary);
  }

  .venue-spaces__header {
    max-width: 760px;
  }

  .venue-spaces__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .venue-spaces__title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .venue-spaces__description {
    max-width: 680px;
    margin: var(--space-7) 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .venue-spaces__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .venue-spaces__item {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    background: var(--color-ivory);
  }

  .venue-spaces__item-title {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .venue-spaces__item-description {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .venue-spaces__note {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .venue-spaces__inner {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .venue-spaces__list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .venue-spaces__title {
      font-size: clamp(2.3rem, 11vw, 3.5rem);
    }

    .venue-spaces__description {
      font-size: 1rem;
    }

    .venue-spaces__item {
      padding: var(--space-5);
    }
  }
</style>
